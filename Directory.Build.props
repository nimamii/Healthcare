<Project>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      C# warnings fail the build, which is deliberate: the spec treats
      Payment, Prescription, Inventory and Authorization as high-risk (§39) and
      a silent warning is exactly how a nullable slip reaches production.

      NuGet warnings are handled separately below, because NU1602/NU1604
      are noise once Central Package Management is on, while NU1902 (a known
      vulnerability) is a genuine finding that must stay fatal.
    -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>NU1602;NU1604;NU1701;NU1702</WarningsNotAsErrors>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditLevel>moderate</NuGetAuditLevel>
    <NuGetAuditMode>direct</NuGetAuditMode>
  </PropertyGroup>

</Project>
