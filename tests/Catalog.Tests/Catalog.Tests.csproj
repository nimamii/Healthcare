<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Mostly domain tests, but ModelShapeTests inspects the EF Core model, which
    means referencing Catalog.Infrastructure. That is a deliberate trade: the
    layer boundary is slightly less pure, and in exchange a schema mismatch
    fails here instead of at insert time on a live request.
  -->

  <PropertyGroup>
    <RootNamespace>Healthcare.Tests.Catalog</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Modules\Catalog\Catalog.Domain\Catalog.Domain.csproj" />
    <ProjectReference Include="..\..\src\Modules\Catalog\Catalog.Infrastructure\Catalog.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\BuildingBlocks\SharedKernel\SharedKernel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="FluentAssertions" />
  </ItemGroup>

</Project>