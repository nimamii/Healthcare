<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Integration tests against a real PostgreSQL, because the property under
    test IS the database's concurrency behaviour. A fake cannot reproduce
    "two transactions read version 1 and one loses".
  -->

  <PropertyGroup>
    <RootNamespace>Healthcare.Tests.Inventory.Integration</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Modules\Inventory\Inventory.Infrastructure\Inventory.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Modules\Inventory\Inventory.Domain\Inventory.Domain.csproj" />
    <ProjectReference Include="..\..\src\BuildingBlocks\SharedKernel\SharedKernel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Npgsql" />
  </ItemGroup>

</Project>