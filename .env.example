# Copy to .env and fill in. NEVER commit .env (§24, §33).
#
#   cp .env.example .env
#
# Generate a signing key with:
#   openssl rand -base64 48

# --- Database (local only) ---
POSTGRES_DB=healthcare
POSTGRES_USER=healthcare
POSTGRES_PASSWORD=local_dev_only
POSTGRES_PORT=15432


# --- S3-compatible storage ---
# Not needed yet. Prescription files arrive in Phase 6, product images in
# Phase 2. The service returns to docker-compose.yml when something reads
# or writes object storage.

# --- JWT ---
# REQUIRED. The API refuses to start without a valid key.
JWT_ISSUER=healthcare-api
JWT_AUDIENCE=healthcare-web
JWT_SIGNING_KEY=

# --- API ---
API_PORT=8090
