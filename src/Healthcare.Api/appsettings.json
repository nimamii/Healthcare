{
  "ConnectionStrings": {
    "//Default": "Set via env var ConnectionStrings__Default — never committed (§24, §33)"
  },

  "Jwt": {
    "//Issuer": "Set via env var Jwt__Issuer",
    "//Audience": "Set via env var Jwt__Audience",
    "//SigningKey": "Set via env var Jwt__SigningKey (min 32 chars)",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14,
    "ClockSkewSeconds": 30
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },

  "AllowedHosts": "*"
}
